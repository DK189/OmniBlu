<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OmniBlu.ViewModels"
        x:Class="OmniBlu.UI.ControlOverlayWindow"
        x:DataType="vm:MainViewModel"
        Title="OmniBlu control"
        Icon="/Assets/omniblu.png"
        Width="300" Height="200"
        CanResize="False" ShowInTaskbar="False" Topmost="True"
        WindowDecorations="None"
        WindowStartupLocation="Manual"
        Background="#0F131A">

    <!-- Small panel in the corner of the screen. It shows who is controlled while the main window is hidden. -->
    <Border BorderBrush="#3DDC84" BorderThickness="2" Padding="16,12">
        <StackPanel VerticalAlignment="Center" Spacing="8">
            <TextBlock Text="CONTROLLING" Foreground="#3DDC84" FontSize="12" FontWeight="Bold" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <TextBlock Classes="emoji" FontSize="30" Text="{Binding ControllingDevice.Icon}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding ControllingDevice.Name}" FontSize="22" FontWeight="Bold"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Classes="hint" Text="{Binding ControlPositionText}" />
            <TextBlock Foreground="#3DDC84" FontSize="16" Text="Press Right Ctrl to stop." />
            <TextBlock Classes="hint" Text="{Binding SwitchHint}" IsVisible="{Binding HasSwitchHint}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Border>
</Window>
