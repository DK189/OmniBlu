<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OmniBlu.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />

        <!-- Panels (the three rows) -->
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#171D27" />
            <Setter Property="BorderBrush" Value="#2A3340" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style Selector="Border.panel.accept">
            <Setter Property="BorderBrush" Value="#4C9AFF" />
            <Setter Property="Background" Value="#18263A" />
        </Style>
        <Style Selector="Border.panel.reject">
            <Setter Property="BorderBrush" Value="#E5534B" />
            <Setter Property="Background" Value="#2B1A1C" />
        </Style>

        <!-- Device cards -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#1F2733" />
            <Setter Property="BorderBrush" Value="#2E3846" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style Selector="Border.card.draggable">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderBrush" Value="#3D5A80" />
        </Style>
        <Style Selector="Border.card.active">
            <Setter Property="BorderBrush" Value="#3DDC84" />
            <Setter Property="Background" Value="#1B2D26" />
        </Style>

        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#8A96A8" />
        </Style>
        <Style Selector="TextBlock.emoji">
            <Setter Property="FontFamily" Value="Segoe UI Emoji" />
        </Style>

        <!-- Status dot -->
        <Style Selector="Ellipse.dot">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Fill" Value="#6B7788" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Ellipse.dot.connecting">
            <Setter Property="Fill" Value="#FFB020" />
        </Style>
        <Style Selector="Ellipse.dot.connected">
            <Setter Property="Fill" Value="#3DDC84" />
        </Style>

        <!-- Priority badge and chips -->
        <Style Selector="Border.badge">
            <Setter Property="Background" Value="#4C9AFF" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.badge > TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#0B1220" />
        </Style>
        <Style Selector="Border.chip">
            <Setter Property="Background" Value="#26364D" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style Selector="Border.chip > TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#9CC4FF" />
        </Style>

        <!-- Buttons -->
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontFamily" Value="Segoe UI Emoji" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Button.pick">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontFamily" Value="Segoe UI Emoji" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Foreground" Value="#8A96A8" />
        </Style>
        <Style Selector="Button.small">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <!-- Inline editable text (device name, hotkey) -->
        <Style Selector="TextBox.inline">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="#3A4656" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="2,3" />
        </Style>
        <Style Selector="TextBox.inline:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#5B6B80" />
        </Style>
        <Style Selector="TextBox.inline:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#10151D" />
            <Setter Property="BorderBrush" Value="#4C9AFF" />
        </Style>
        <Style Selector="TextBox.inline.invalid /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#E5534B" />
        </Style>
    </Application.Styles>
</Application>
